# VaultGuard Environment Configuration Example
# Copy this file to backend/.env (or root .env) and replace placeholder values before running.

# Flask application settings
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret keys (REQUIRED in production; auto-generated locally for student dev if omitted)
# Generate strong random strings, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-flask-secret-key
JWT_SECRET_KEY=change-this-to-a-strong-random-jwt-secret-key

# AES-256-GCM Master Encryption Key (Base64-encoded 32-byte key)
# Generate with: python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# If left blank during local setup, VaultGuard generates and stores a key in backend/instance/vaultguard.key
VAULTGUARD_ENCRYPTION_KEY=

# Database (defaults to SQLite inside backend/instance/vaultguard.db)
DATABASE_URL=sqlite:///vaultguard.db

# Authentication & Lockout Policy
BCRYPT_LOG_ROUNDS=12
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=5

# Rule-Based Risk Engine Thresholds
RISK_LOW_MAX=19
RISK_MEDIUM_MAX=39
RISK_HIGH_MIN=40
RETRIEVAL_BURST_THRESHOLD=5
RETRIEVAL_WINDOW_SECONDS=120
FAILED_LOGIN_WINDOW_MINUTES=15

# Optional External AI API (leave blank to use built-in rule-based Security Assistant)
# Never sends passwords, keys, or credential contents — only sanitized event metadata.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
